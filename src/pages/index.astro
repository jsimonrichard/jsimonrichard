---
import Layout from '~/layouts/Layout.astro';
import { Image } from 'astro:assets';
import profileImage from '~/img/profile.jpg';
import { englishList } from '~/components/solid/utils';
import { getCollection } from 'astro:content';
import { sortBySortIndex } from '~/content/config';
import Bibliography from '~/components/Bibliography.astro';
import BibItem from '~/components/BibItem.astro';
import ResumeEntry from '~/components/ResumeEntry.astro';

const education = await getCollection('resume-education');
const researchExp = await getCollection('resume-research-experience');
const leadershipTeachingExp = await getCollection(
  'resume-leadership-teaching-experience',
);
const techExp = await getCollection('resume-tech-experience');
const publications = await getCollection('resume-publications');
const honors = await getCollection('resume-honors');
const projects = await getCollection('resume-projects');
education.sort(sortBySortIndex);
researchExp.sort(sortBySortIndex);
leadershipTeachingExp.sort(sortBySortIndex);
techExp.sort(sortBySortIndex);
publications.sort(sortBySortIndex);
honors.sort(sortBySortIndex);
projects.sort(sortBySortIndex);

const headingClass =
  'text-xl font-bold mb-3 pb-2 border-b-2 border-muted-foreground text-left';
const titleClass = 'text-base font-bold mb-1';
const metaClass = 'text-muted-foreground mb-2';
const linkClass = 'text-link hover:text-link-hover hover:underline';
---

<Layout title="J. Simon Richard" compactNav>
  <main class="max-w-4xl mx-auto px-4 pt-28 pb-16">
    <section id="hero" class="flex flex-col sm:flex-row gap-8 mb-16 items-center sm:items-start">
      <Image
        src={profileImage}
        alt="J. Simon Richard"
        width={300}
        height={300}
        class="w-28 h-28 sm:w-36 sm:h-36 rounded-full object-cover shrink-0"
      />
      <div>
        <h1 class="text-3xl font-bold mb-4">J. Simon Richard</h1>
        <p class="mb-4">
          I'm a <strong>second-year PhD student at Purdue University</strong>.
          I study how formal methods can improve LLM reasoning, especially by
          verifying AI-generated code and by using LLMs to make formal methods
          more accessible.
        </p>

        <p class="mb-2">Interests:</p>
        <ul class="list-disc list-inside ml-2 columns-2xs">
          <li>Large Language Model (LLM) reasoning</li>
          <li>Formal Program Verification</li>
          <li>Specification Generation</li>
          <li>Programming Languages</li>
          <li>Agentic Software Engineering</li>
        </ul>
      </div>
    </section>

    <section id="education" class="mb-14">
      <h2 class={headingClass}>Education</h2>
      {
        education.map((edu: any) => (
          <ResumeEntry when={edu.data.graduation}>
            <h3 class={titleClass}>
              {edu.data.name}
              {edu.data.gpa && ` | ${edu.data.gpa} GPA`}
            </h3>
            <p class={metaClass}>{edu.data.location}</p>
            <ul class="list-disc list-outside ml-6">
              {edu.data.notes.map((n: string) => (
                <li>{n}</li>
              ))}
            </ul>
          </ResumeEntry>
        ))
      }
    </section>

    <section id="research-experience" class="mb-14">
      <h2 class={headingClass}>Research Experience</h2>
      {
        researchExp.map((r: any) => (
          <ResumeEntry start={r.data.start} end={r.data.end}>
            {r.data.link ? (
              <a href={r.data.link} target="_blank" class={linkClass}>
                <h3 class={titleClass}>{r.data.name}</h3>
              </a>
            ) : (
              <h3 class={titleClass}>{r.data.name}</h3>
            )}
            <p class={metaClass}>
              {r.data.location}
              {r.data.advisors.length > 0 && (
                <>
                  <br />
                  Advised by{' '}
                  {englishList(
                    r.data.advisors.map((ad: string) => <strong>{ad}</strong>),
                  )}
                </>
              )}
            </p>
            <ul class="list-disc list-outside ml-6">
              {r.data.notes.map((n: string) => (
                <li>{n}</li>
              ))}
            </ul>
          </ResumeEntry>
        ))
      }
    </section>

    <section id="publications" class="mb-14">
      <h2 class={headingClass}>Publications</h2>
      <Bibliography class="flex flex-col gap-4 pt-3">
        {publications.map((pub: any) => {
          const parts = pub.data.citation.split('{link}');
          if (parts.length !== 2) {
            throw new Error(
              `citation must contain exactly one {link}: ${pub.id}`,
            );
          }
          return (
            <BibItem>
              {parts[0]}
              <a href={pub.data.href} class={linkClass}>
                {pub.data.linkLabel}
              </a>
              {parts[1]}
            </BibItem>
          );
        })}
      </Bibliography>
    </section>

    <section id="leadership-teaching-experience" class="mb-14">
      <h2 class={headingClass}>Leadership & Teaching Experience</h2>
      {
        leadershipTeachingExp.map((l: any) => (
          <ResumeEntry start={l.data.start} end={l.data.end}>
            <h3 class={titleClass}>{l.data.name}</h3>
            <p class={metaClass}>{l.data.location}</p>
            <ul class="list-disc list-outside ml-6">
              {l.data.notes.map((n: string) => (
                <li>{n}</li>
              ))}
            </ul>
          </ResumeEntry>
        ))
      }
    </section>

    <section id="additional-tech-experience" class="mb-14">
      <h2 class={headingClass}>Additional Technical Experience</h2>
      {
        techExp.map((t: any) => (
          <ResumeEntry start={t.data.start} end={t.data.end}>
            <h3 class={titleClass}>{t.data.name}</h3>
            <p class={metaClass}>{t.data.location}</p>
            <ul class="list-disc list-outside ml-6">
              {t.data.notes.map((n: string) => (
                <li>{n}</li>
              ))}
            </ul>
          </ResumeEntry>
        ))
      }
    </section>

    <section id="projects" class="mb-14">
      <h2 class={headingClass}>Side Projects</h2>
      <ul class="flex flex-col gap-5 pt-3">
        {
          projects.map((p: any) => (
            <li>
              {p.data.link ? (
                <a
                  href={p.data.link}
                  target="_blank"
                  class:list={[linkClass, 'font-bold']}
                >
                  {p.data.name}
                </a>
              ) : (
                <strong>{p.data.name}</strong>
              )}{' '}
              {p.data.summary}
            </li>
          ))
        }
      </ul>
    </section>

    <section id="other-honors" class="mb-8">
      <h2 class={headingClass}>Other Honors</h2>
      <ul class="list-disc list-outside ml-6 pt-3">
        {honors.map((h: any) => (
          <li>{h.data.text}</li>
        ))}
      </ul>
    </section>
  </main>
</Layout>
